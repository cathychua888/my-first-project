# Copy this file to ".env.local" and fill in the values.
# NEVER commit .env.local or share your keys. (.env* files are ignored by git.)

# ---- AI (required) ----
# Create a key at https://platform.claude.com (Settings -> API Keys).
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: how much the AI "thinks" before answering: low | medium | high (default: medium).
# Lower = faster and cheaper; higher = more careful.
# ANTHROPIC_EFFORT=medium

# ---- Abuse protection ----
# Max AI generations per visitor per hour (default: 30).
# RATE_LIMIT_PER_HOUR=30

# ---- Paid access (leave OFF until a payment provider is connected) ----
# PAYWALL_ENABLED=false
# Long random secret for signing access tokens (e.g. run: openssl rand -hex 32)
# ACCESS_TOKEN_SECRET=
